# Copy to .env (which is git-ignored) and fill in real values.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string
APP_ENV=prod
HOST_PORT=8080
# Release to build/run. Tag images with the version so you can roll back.
APP_VERSION=1.0.0
IMAGE_TAG=1.0.0
