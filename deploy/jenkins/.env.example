# Copy to deploy/jenkins/.env (git-ignored) and choose your own values.
JENKINS_ADMIN_PASSWORD=choose-a-password
# SECRET_KEY the pipeline gives the deployed app. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HOTEL_SECRET_KEY=replace-me-with-a-long-random-string
# Optional: build from GitHub instead of the local folder once you push.
# HOTEL_REPO_URL=https://github.com/<you>/<repo>.git
# HOTEL_REPO_BRANCH=develop
